    "orderUseCases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setting the running order for talks and demos, rotating who hosts, assigning chores or reviews, rearranging seats, or standing in for drawing lots. No sign-up, free to use."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発表やプレゼンの順番決め、幹事の持ち回り、掃除当番の割り当て、チーム内のレビュー担当、席替え、くじ引きの代わりに。登録不要で無料で使えます。"
          }
        }
      }
    },
