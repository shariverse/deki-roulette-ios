    "orderHelpAim" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold an item for about 0.6 seconds to cycle it through first, last, and off. Only one item can hold each position, so marking another one clears the previous mark."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を 0.6 秒ほど長押しすると、先頭 → 末尾 → 解除の順に切り替わります。先頭と末尾はそれぞれ 1 項目までで、別の項目に付け替えると前の指定は外れます。"
          }
        }
      }
    },
    "orderHelpAimRandom" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you have not marked is always shuffled at random. With nothing marked, the order really is random."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した項目以外の並びは常にランダムです。何も指定しなければ、順番は本当にランダムです。"
          }
        }
      }
    },
    "orderHelpAimStealth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mark only appears while you are touching an item and right after you set it. It disappears while shuffling and while the result is up, and stays hidden while the screen is being shared or recorded. This section closes itself the moment you press Shuffle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した印は、項目に触れている間と指定した直後だけ出ます。並べ替え中と結果表示中は消え、画面を共有・収録している間も出ません。この説明も並べ替えを押すと自動で閉じます。"
          }
        }
      }
    },
    "orderHelpAimTitle" : {
