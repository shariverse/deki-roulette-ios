    "helpAim" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold an item for about 0.6 seconds and it will be the one the next spin lands on. Hold again to clear it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を 0.6 秒ほど長押しすると、その項目が次のスピンで選ばれます。もう一度長押しすると解除されます。"
          }
        }
      }
    },
    "helpAimRandom" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With nothing marked, the result really is random."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も指定しなければ、結果は本当にランダムです。"
          }
        }
      }
    },
    "helpAimStealth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mark only appears while you are touching an item and right after you set it. It disappears while spinning and while the result is up, and stays hidden while the screen is being shared or recorded. This section closes itself the moment you press Spin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した印は、項目に触れている間と指定した直後だけ出ます。スピン中と結果表示中は消え、画面を共有・収録している間も出ません。この説明もスピンを押すと自動で閉じます。"
          }
        }
      }
    },
    "helpAimTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the result is already decided"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果を決めておきたいとき"
          }
        }
      }
    },
    "helpBasic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your options and press Spin. You can register between 2 and 24 items. Paste text with one entry per line to add them all at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を追加してスピンを押すだけです。項目は 2 個から 24 個まで登録できます。改行区切りの文章を貼り付けると、まとめて追加できます。"
          }
        }
      }
    },
